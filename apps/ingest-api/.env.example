NODE_ENV=development
HOST=0.0.0.0
PORT=8080
TRUST_PROXY=false
DATABASE_URL=postgres://sluice_api:change-me@localhost:5432/sluice
DATABASE_SSL=false
DATABASE_SSL_CA_FILE=
REDIS_URL=redis://:change-me@localhost:6379/0
# closed rejects traffic with 503 when Redis cannot enforce a limit; open is opt-in.
REDIS_FAILURE_POLICY=closed
WEBHOOK_BODY_LIMIT_BYTES=1048576
DEFAULT_RATE_LIMIT=120
DEFAULT_RATE_WINDOW_SECONDS=60
SIGNATURE_TOLERANCE_SECONDS=300
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=10000
# Comma-separated keyring: version:base64(32 bytes). Keep outside Postgres.
SLUICE_MASTER_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
SLUICE_ACTIVE_KEY_VERSION=1
# Optional bearer token protecting /metrics. Empty exposes metrics to the network.
METRICS_BEARER_TOKEN=

# Used only by `npm run bootstrap:source`. The runtime sluice_api role cannot
# insert source records by design. Use the dashboard/provisioning role and pass
# an owner/admin UUID with --actor-user-id so database RLS remains authoritative.
SLUICE_BOOTSTRAP_DATABASE_URL=postgres://sluice_dashboard:change-me@localhost:5432/sluice
SLUICE_BOOTSTRAP_DATABASE_SSL=false
# Inject these only for the bootstrap process; do not keep real values in files.
SLUICE_BOOTSTRAP_SECRET=
SLUICE_BOOTSTRAP_CONFIG_JSON={}
