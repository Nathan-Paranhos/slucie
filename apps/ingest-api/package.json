{
  "name": "@sluice/ingest-api",
  "version": "0.1.0",
  "description": "Secure, multi-tenant webhook ingestion edge for Sluice",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude test/integration/**",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration",
    "bootstrap:source": "tsx src/cli/bootstrap-source.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "fastify": "^5.11.3",
    "ioredis": "^5.6.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
