SLUICE_DEMO_MODE=true
SLUICE_SESSION_SECRET=replace-with-at-least-32-random-characters
SLUICE_COOKIE_SECURE=false
DASHBOARD_TRUST_PROXY=false
SLUICE_DEMO_EMAIL=admin@sluice.local
SLUICE_DEMO_PASSWORD=sluice-demo
# Required when demo mode is false and the dashboard creates encrypted resources.
SLUICE_MASTER_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
SLUICE_ACTIVE_KEY_VERSION=1
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_FILE=
WORKER_DISPLAY_CAPACITY=32
