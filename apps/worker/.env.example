# PostgreSQL is the durable queue. Use the non-owner sluice_worker role.
SLUICE_WORKER_DATABASE_URL=Host=postgres;Port=5432;Database=sluice;Username=sluice_worker;Password=change-me
# The TLS overlay sets these to true and the mounted CA path. Npgsql then uses
# VerifyFull, including hostname validation.
DATABASE_SSL=false
DATABASE_SSL_CA_FILE=

# Redis is optional and accepts wake-up from an external publisher. PostgreSQL
# LISTEN/NOTIFY and polling remain active.
REDIS_URL=redis:6379,password=change-me,defaultDatabase=0,abortConnect=false

# Preferred rotation-capable keyring: version:base64,version:base64
SLUICE_MASTER_KEYS=1:REPLACE_WITH_BASE64_OF_EXACTLY_32_BYTES
SLUICE_ACTIVE_KEY_VERSION=1

WORKER_ID=sluice-worker
WORKER_CONCURRENCY=16
WORKER_CLAIM_BATCH_SIZE=20
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=20
WORKER_POLL_INTERVAL_MS=2000
WORKER_DRAIN_SECONDS=30

# Bind this endpoint only to an internal network or place it behind TLS.
WORKER_DIAGNOSTICS_URL=http://0.0.0.0:8080
WORKER_METRICS_BEARER_TOKEN=replace-with-a-long-random-token

# Provider -> fixed HTTPS base URL. Encrypted source config can only add a path.
WORKER_RECONCILIATION_ENDPOINTS_JSON={"stripe":"https://api.stripe.com/v1/","asaas":"https://api.asaas.com/v3/"}

# Optional fixed delivery APIs for notification_outbox.
WORKER_NOTIFICATION_WEBHOOK_URL=https://alerts.example.com/sluice
WORKER_NOTIFICATION_EMAIL_URL=https://mail.example.com/v1/send
WORKER_NOTIFICATION_ALLOWED_HOSTS=alerts.example.com,mail.example.com
WORKER_NOTIFICATION_TIMEOUT_MS=10000
