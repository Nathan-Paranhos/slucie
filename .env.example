# Copy to .env for local development. Never commit real credentials.
COMPOSE_PROJECT_NAME=sluice

# PostgreSQL
POSTGRES_DB=sluice
POSTGRES_ADMIN_USER=sluice_admin
POSTGRES_ADMIN_PASSWORD=local-admin-change-this-password
SLUICE_API_DB_PASSWORD=local-api-change-this-password
SLUICE_WORKER_DB_PASSWORD=local-worker-change-this-password
SLUICE_DASHBOARD_DB_PASSWORD=local-dashboard-change-this-password
SLUICE_READONLY_DB_PASSWORD=local-readonly-change-this-password
POSTGRES_HOST_PORT=5432
POSTGRES_LOG_MIN_DURATION_MS=1000

# Runtime connection strings. Hostnames are Docker service names.
SLUICE_API_DATABASE_URL=postgresql://sluice_api:local-api-change-this-password@postgres:5432/sluice
SLUICE_WORKER_DATABASE_URL=Host=postgres;Port=5432;Database=sluice;Username=sluice_worker;Password=local-worker-change-this-password
SLUICE_DASHBOARD_DATABASE_URL=postgresql://sluice_dashboard:local-dashboard-change-this-password@postgres:5432/sluice

# Redis is ephemeral: rate limits and an optional external wake-up channel only.
REDIS_PASSWORD=local-redis-change-this-password
REDIS_URL=redis://:local-redis-change-this-password@redis:6379/0
# StackExchange.Redis uses its native comma-separated configuration format.
SLUICE_WORKER_REDIS_URL=redis:6379,password=local-redis-change-this-password,defaultDatabase=0,abortConnect=false
REDIS_HOST_PORT=6379
REDIS_MAXMEMORY=256mb

# 32 random bytes, Base64 encoded. Generate a local key with:
#   openssl rand -base64 32
# In production, inject this from a secret manager; never store it beside the DB.
# This all-zero value is only a deterministic local-development placeholder.
SLUICE_MASTER_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SLUICE_MASTER_KEY_VERSION=1
SLUICE_MASTER_KEYS=1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SLUICE_ACTIVE_KEY_VERSION=1

# Applications
NODE_ENV=development
# Política de autenticação do dashboard em runtime. O overlay dev força development.
SLUICE_RUNTIME_ENV=development
ASPNETCORE_ENVIRONMENT=Development
SLUICE_IMAGE_TAG=local

# Ingest API
INGEST_API_PORT=3001
TRUST_PROXY=false
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_FILE=
REDIS_FAILURE_POLICY=closed
WEBHOOK_BODY_LIMIT_BYTES=1048576
DEFAULT_RATE_LIMIT=120
DEFAULT_RATE_WINDOW_SECONDS=60
SIGNATURE_TOLERANCE_SECONDS=300
INGEST_DB_POOL_MAX=20
INGEST_DB_STATEMENT_TIMEOUT_MS=5000
INGEST_SHUTDOWN_GRACE_MS=10000
INGEST_METRICS_BEARER_TOKEN=

# Dashboard
DASHBOARD_PORT=3000
DASHBOARD_DB_POOL_SIZE=8
# Set true only when the dashboard is deployed behind a trusted reverse proxy.
DASHBOARD_TRUST_PROXY=false
SLUICE_SESSION_SECRET=local-dashboard-session-secret-change-before-production-0123456789
SLUICE_DEMO_MODE=false
SLUICE_DEMO_EMAIL=
SLUICE_DEMO_PASSWORD=
# Desenvolvimento local usa HTTP; em produção o runtime sempre emite cookie Secure.
SLUICE_COOKIE_SECURE=false
# Produção: OIDC é obrigatório. Exija um valor ACR emitido pelo IdP após MFA.
SLUICE_OIDC_ISSUER=
SLUICE_OIDC_CLIENT_ID=
SLUICE_OIDC_CLIENT_SECRET=
SLUICE_OIDC_REQUIRED_ACR=
WORKER_DISPLAY_CAPACITY=32

# .NET worker
WORKER_DIAGNOSTICS_PORT=8082
WORKER_ID=sluice-worker
WORKER_CONCURRENCY=16
WORKER_CLAIM_BATCH_SIZE=20
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=20
WORKER_POLL_INTERVAL_MS=2000
WORKER_DRAIN_SECONDS=30
WORKER_METRICS_BEARER_TOKEN=
WORKER_RECONCILIATION_ENDPOINTS_JSON=
WORKER_NOTIFICATION_WEBHOOK_URL=
WORKER_NOTIFICATION_EMAIL_URL=
WORKER_NOTIFICATION_ALLOWED_HOSTS=
WORKER_NOTIFICATION_TIMEOUT_MS=10000

# Production TLS overlay (infra/compose.tls.yml)
POSTGRES_TLS_CERT_FILE=./secrets/postgres/server.crt
POSTGRES_TLS_KEY_FILE=./secrets/postgres/server.key
POSTGRES_TLS_CA_FILE=./secrets/postgres/ca.crt
